rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Reusable Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAllowedMemberId(id) {
      return id in ['kakao_hyunwoo_mom', 'kakao_sehyun_mom', 'kakao_hyunwoo', 'kakao_sehyun'];
    }

    function isValidExpeditionProfile(data) {
      return data.keys().hasAll(['memberId', 'nickname', 'defaultNickname', 'avatarId', 'avatarEmoji', 'updatedAt'])
        && data.keys().hasOnly(['memberId', 'nickname', 'defaultNickname', 'avatarId', 'avatarEmoji', 'profileImageUrl', 'updatedAt'])
        && isValidId(data.memberId)
        && isAllowedMemberId(data.memberId)
        && data.nickname is string
        && data.nickname.size() >= 1
        && data.nickname.size() <= 40
        && data.defaultNickname is string
        && data.defaultNickname.size() >= 1
        && data.defaultNickname.size() <= 20
        && data.defaultNickname in ['현우맘', '세현맘', '현우', '세현']
        && data.avatarId is string
        && data.avatarId.size() >= 1
        && data.avatarId.size() <= 64
        && data.avatarId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.avatarEmoji is string
        && data.avatarEmoji.size() >= 1
        && data.avatarEmoji.size() <= 16
        && (!('profileImageUrl' in data) || (data.profileImageUrl is string && data.profileImageUrl.size() >= 1 && data.profileImageUrl.size() <= 500000))
        && data.updatedAt is timestamp;
    }

    function isValidStampMission(data) {
      return data.keys().hasAll([
          'missionId',
          'tripId',
          'dayNumber',
          'title',
          'placeTag',
          'rewardPoint',
          'hyunwooStamped',
          'sehyunStamped',
          'hyunwooRequested',
          'sehyunRequested',
          'praiseNote',
          'updatedBy',
          'isDeleted',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'missionId',
          'tripId',
          'dayNumber',
          'title',
          'placeTag',
          'rewardPoint',
          'hyunwooStamped',
          'sehyunStamped',
          'hyunwooRequested',
          'sehyunRequested',
          'praiseNote',
          'updatedBy',
          'isDeleted',
          'updatedAt'
        ])
        && isValidId(data.missionId)
        && data.tripId is string
        && data.tripId.size() >= 1
        && data.tripId.size() <= 32
        && data.tripId == 'tokyo_2027'
        && data.dayNumber is int
        && data.dayNumber >= 0
        && data.dayNumber <= 6
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 80
        && data.placeTag is string
        && data.placeTag.size() >= 1
        && data.placeTag.size() <= 40
        && data.rewardPoint is int
        && data.rewardPoint >= 1
        && data.rewardPoint <= 5
        && data.hyunwooStamped is bool
        && data.sehyunStamped is bool
        && data.hyunwooRequested is bool
        && data.sehyunRequested is bool
        && data.praiseNote is string
        && data.praiseNote.size() <= 120
        && data.updatedBy is string
        && data.updatedBy.size() >= 1
        && data.updatedBy.size() <= 40
        && data.isDeleted is bool
        && data.updatedAt is timestamp;
    }

    // 3. Expedition Profiles Collection (/profiles/{memberId})
    match /profiles/{memberId} {
      allow get: if isValidId(memberId) && isAllowedMemberId(memberId);
      allow list: if existing().memberId in ['kakao_hyunwoo_mom', 'kakao_sehyun_mom', 'kakao_hyunwoo', 'kakao_sehyun'];

      allow create: if isValidId(memberId)
        && isAllowedMemberId(memberId)
        && isValidExpeditionProfile(incoming())
        && incoming().memberId == memberId
        && incoming().updatedAt == request.time;

      allow update: if isValidId(memberId)
        && isAllowedMemberId(memberId)
        && isValidExpeditionProfile(incoming())
        && incoming().memberId == existing().memberId
        && incoming().defaultNickname == existing().defaultNickname
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['nickname', 'avatarId', 'avatarEmoji', 'profileImageUrl', 'updatedAt']);

      allow delete: if false;
    }

    // 4. Expedition Stamp Missions & Praise Board Collection (/stampMissions/{missionId})
    match /stampMissions/{missionId} {
      allow get: if isValidId(missionId);
      allow list: if existing().tripId == 'tokyo_2027';

      allow create: if isValidId(missionId)
        && isValidStampMission(incoming())
        && incoming().missionId == missionId
        && incoming().updatedAt == request.time;

      allow update: if isValidId(missionId)
        && isValidStampMission(incoming())
        && incoming().missionId == existing().missionId
        && incoming().tripId == existing().tripId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'dayNumber',
          'title',
          'placeTag',
          'rewardPoint',
          'hyunwooStamped',
          'sehyunStamped',
          'hyunwooRequested',
          'sehyunRequested',
          'praiseNote',
          'updatedBy',
          'isDeleted',
          'updatedAt'
        ]);

      allow delete: if false;
    }

    // 5. Connectivity Validation Path (/test/{docId})
    match /test/{docId} {
      allow get: if isValidId(docId) && docId == 'connection';
      allow list, create, update, delete: if false;
    }
  }
}
